# Test environment configuration
# Used by tests/setup/setup.ts (dotenv) and src/config/environment.ts (zod validation)
# Values are dummy/test-only — never used against real infrastructure.

NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Database - PostgreSQL (test instance)
DATABASE_URL=postgresql://test:test@localhost:5432/featherlight_test
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/featherlight_test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Firebase Authentication (dummy — not called in tests)
FIREBASE_PROJECT_ID=test-project
FIREBASE_PRIVATE_KEY=test-private-key
FIREBASE_CLIENT_EMAIL=test@test-project.iam.gserviceaccount.com

# JWT / Session Configuration — dummy 32+ char secrets
JWT_SECRET=test-jwt-secret-must-be-at-least-32-chars
JWT_REFRESH_SECRET=test-jwt-refresh-secret-at-least-32-chars
SESSION_SECRET=test-session-secret-at-least-32-characters

# AI Provider Configuration (dummy — not called in tests)
AI_PROVIDER=openai
OPENAI_API_KEY=test-key
CLAUDE_API_KEY=test-key
